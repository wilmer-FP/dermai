# ==========================================================
# DermAI - Variables de entorno de EJEMPLO
# Copia este archivo como .env y ajusta los valores localmente.
# NO incluyas credenciales reales en este archivo.
# ==========================================================

# ---------- Entorno ----------
APP_NAME=DermAI
# Valores posibles: development | testing | production
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---------- Backend (FastAPI) ----------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=change-me-in-your-local-env

# ---------- Base de datos (PostgreSQL en Docker, ver docker-compose.yml) ----------
# scripts/db-init.ps1 genera una contraseña aleatoria y rellena estos valores.
POSTGRES_USER=dermai_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=dermai_db
POSTGRES_PORT=5433
# Formato SQLAlchemy con el driver psycopg 3: postgresql+psycopg://...
# Se usa 127.0.0.1 en lugar de localhost: en Windows, localhost resuelve primero a
# IPv6 (::1) y Docker Desktop deja esa conexión colgada.
DATABASE_URL=postgresql+psycopg://dermai_user:your_password@127.0.0.1:5433/dermai_db
DB_ECHO=false

# ---------- Almacenamiento ----------
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png

# ---------- Inteligencia artificial ----------
# Los modelos se registran en la tabla model_versions (python -m app.cli register-model).
# AI_MODEL_PATH ya no se usa: cada versión de modelo guarda su propia ruta de pesos.
# Dispositivo de inferencia. Valores posibles: cpu | cuda | auto (GPU si está disponible)
AI_DEVICE=cpu
